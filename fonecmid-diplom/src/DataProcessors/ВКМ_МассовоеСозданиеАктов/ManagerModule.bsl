
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает абонентские договоры, действующие в месяце периода,
// и ссылки на уже созданные по ним реализации за этот месяц.
//
// Параметры:
//  Период - Дата - любая дата месяца.
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * Договор    - СправочникСсылка.ДоговорыКонтрагентов
//   * Контрагент - СправочникСсылка.Контрагенты
//   * Реализация - ДокументСсылка.РеализацияТоваровУслуг
//
Функция ДоговорыПериода(Период) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Договоры.Ссылка КАК Договор,
	|	Договоры.Владелец КАК Контрагент,
	|	Реализации.Ссылка КАК Реализация
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг КАК Реализации
	|		ПО Договоры.Ссылка = Реализации.Договор
	|			И Реализации.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|			И НЕ Реализации.ПометкаУдаления
	|ГДЕ
	|	Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание)
	|	И НЕ Договоры.ПометкаУдаления
	|	И Договоры.ВКМ_ДатаНачалаДействия <= &КонецПериода
	|	И (Договоры.ВКМ_ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ Договоры.ВКМ_ДатаОкончанияДействия >= &НачалоПериода)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент,
	|	Договор";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Период));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Период));
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Договор");
	Результат.Колонки.Добавить("Контрагент");
	Результат.Колонки.Добавить("Реализация");
	
	Обработанные = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Обработанные.Получить(Выборка.Договор) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработанные.Вставить(Выборка.Договор, Истина);
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли
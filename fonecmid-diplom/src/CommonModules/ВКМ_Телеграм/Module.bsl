#Область ПрограммныйИнтерфейс

// Отправляет текстовое сообщение в группу Телеграм от имени бота.
//
// Параметры:
//  ТекстСообщения - Строка - текст сообщения.
//
// Возвращаемое значение:
//  Булево - Истина, если сообщение успешно отправлено.
//
Функция ОтправитьСообщение(ТекстСообщения) Экспорт
	
	Токен = Константы.ВКМ_ТокенТелеграмБота.Получить();
	ИдентификаторГруппы = Константы.ВКМ_ИдентификаторГруппыТелеграм.Получить();
	
	Если Не ЗначениеЗаполнено(Токен) Или Не ЗначениеЗаполнено(ИдентификаторГруппы) Тогда
		ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			НСтр("ru = 'Не заполнены константы для интеграции с телеграм-ботом.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Тело = Новый Структура;
	Тело.Вставить("chat_id", ИдентификаторГруппы);
	Тело.Вставить("text", ТекстСообщения);
	
	HTTPЗапрос = Новый HTTPЗапрос("/bot" + Токен + "/sendMessage");
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON(Тело));
	
	Попытка
		Соединение = Новый HTTPСоединение("api.telegram.org", , , , , 30, Новый ЗащищенноеСоединениеOpenSSL);
		//@skip-check bsl-legacy-check-dynamic-feature-access
		Ответ = Соединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
	Исключение
		ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;
	
	Если Ответ.КодСостояния <> 200 Тогда
		ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон(НСтр("ru = 'Ошибка отправки сообщения в Телеграм. Код состояния: %1. Ответ: %2'"),
				Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку()));
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Отправляет накопленные уведомления в Телеграм и удаляет успешно отправленные.
// Вызывается регламентным заданием.
//
Процедура ОтправитьУведомления() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Уведомления.Ссылка КАК Ссылка,
	|	Уведомления.ТекстСообщения КАК ТекстСообщения
	|ИЗ
	|	Справочник.ВКМ_УведомленияТелеграмБоту КАК Уведомления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ОтправитьСообщение(Выборка.ТекстСообщения) Тогда
			Продолжить;
		КонецЕсли;
		УведомлениеОбъект = Выборка.Ссылка.ПолучитьОбъект();
		УведомлениеОбъект.Удалить();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СобытиеЖурнала()
	
	Возврат "ВКМ.Телеграм";
	
КонецФункции

Функция СтрокаJSON(Данные)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

#КонецОбласти
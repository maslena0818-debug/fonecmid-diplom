#Область ПрограммныйИнтерфейс

// Заполняет регистр сведений ВКМ_ГрафикРаботы по пятидневной рабочей неделе
// за указанный период. Уже заполненные даты не перезаписываются.
//
// Параметры:
//  ДатаНачала - Дата - начало периода заполнения.
//  ДатаОкончания - Дата - окончание периода заполнения.
//
Процедура ЗаполнитьГрафикРаботы(Знач ДатаНачала, Знач ДатаОкончания) Экспорт
	
	ДатаНачала = НачалоДня(ДатаНачала);
	ДатаОкончания = НачалоДня(ДатаОкончания);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГрафикРаботы.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.ВКМ_ГрафикРаботы КАК ГрафикРаботы
	|ГДЕ
	|	ГрафикРаботы.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	
	ЗаполненныеДаты = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполненныеДаты.Вставить(Выборка.Дата, Истина);
	КонецЦикла;
	
	ТекущаяДата = ДатаНачала;
	Пока ТекущаяДата <= ДатаОкончания Цикл
		
		Если ЗаполненныеДаты[ТекущаяДата] = Неопределено Тогда
			МенеджерЗаписи = РегистрыСведений.ВКМ_ГрафикРаботы.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.Дата = ТекущаяДата;
			МенеджерЗаписи.Значение = ?(ДеньНедели(ТекущаяДата) < 6, 1, 0);
			МенеджерЗаписи.Записать();
		КонецЕсли;
		
		ТекущаяДата = ТекущаяДата + 86400;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает количество рабочих дней по графику ВКМ_ГрафикРаботы за период.
//
// Параметры:
//  ДатаНачала - Дата - начало периода.
//  ДатаОкончания - Дата - окончание периода.
//
// Возвращаемое значение:
//  Число - количество рабочих дней.
//
Функция КоличествоРабочихДней(Знач ДатаНачала, Знач ДатаОкончания) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ГрафикРаботы.Значение), 0) КАК КоличествоДней
	|ИЗ
	|	РегистрСведений.ВКМ_ГрафикРаботы КАК ГрафикРаботы
	|ГДЕ
	|	ГрафикРаботы.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КоличествоДней;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Формирует движения по регистру расчета ВКМ_Удержания (НДФЛ)
// от суммы начислений, переданных в наборах записей.
//
// Параметры:
//  НаборЗаписейУдержаний - РегистрРасчетаНаборЗаписей.ВКМ_Удержания - набор записей документа.
//  НаборыНачислений - Массив из РегистрРасчетаНаборЗаписей - наборы записей регистров начислений документа.
//  ПериодРегистрации - Дата - период регистрации (начало месяца).
//
Процедура СформироватьНДФЛ(НаборЗаписейУдержаний, НаборыНачислений, ПериодРегистрации) Экспорт
	
	СуммыПоСотрудникам = Новый Соответствие;
	
	Для Каждого НаборЗаписей Из НаборыНачислений Цикл
		Для Каждого ЗаписьНачисления Из НаборЗаписей Цикл
			ТекущаяСумма = СуммыПоСотрудникам[ЗаписьНачисления.Сотрудник];
			Если ТекущаяСумма = Неопределено Тогда
				ТекущаяСумма = 0;
			КонецЕсли;
			СуммыПоСотрудникам.Вставить(ЗаписьНачисления.Сотрудник, ТекущаяСумма + ЗаписьНачисления.Результат);
		КонецЦикла;
	КонецЦикла;
	
	НаборЗаписейУдержаний.Записывать = Истина;
	
	Для Каждого ЭлементСоответствия Из СуммыПоСотрудникам Цикл
		
		СуммаНачислений = ЭлементСоответствия.Значение;
		Если СуммаНачислений <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = НаборЗаписейУдержаний.Добавить();
		Движение.ПериодРегистрации = ПериодРегистрации;
		Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_Удержания.НДФЛ;
		Движение.Сотрудник = ЭлементСоответствия.Ключ;
		Движение.БазовыйПериодНачало = НачалоМесяца(ПериодРегистрации);
		Движение.БазовыйПериодКонец = КонецМесяца(ПериодРегистрации);
		Движение.Результат = Окр(СуммаНачислений * СтавкаНДФЛ() / 100, 0);
		
	КонецЦикла;
	
КонецПроцедуры


// Формирует движения по регистру накопления ВКМ_ВзаиморасчетыССотрудниками:
// начисления документа минус удержания документа.
//
// Параметры:
//  НаборЗаписейВзаиморасчетов - РегистрНакопленияНаборЗаписей.ВКМ_ВзаиморасчетыССотрудниками - набор записей документа.
//  НаборыНачислений - Массив из РегистрРасчетаНаборЗаписей - наборы записей регистров начислений документа.
//  НаборЗаписейУдержаний - РегистрРасчетаНаборЗаписей.ВКМ_Удержания - набор записей удержаний документа.
//  Период - Дата - дата движений.
//
Процедура СформироватьВзаиморасчеты(НаборЗаписейВзаиморасчетов, НаборыНачислений, НаборЗаписейУдержаний, Период) Экспорт
	
	СуммыПоСотрудникам = Новый Соответствие;
	
	Для Каждого НаборЗаписей Из НаборыНачислений Цикл
		Для Каждого ЗаписьНачисления Из НаборЗаписей Цикл
			ДобавитьСуммуСотруднику(СуммыПоСотрудникам, ЗаписьНачисления.Сотрудник, ЗаписьНачисления.Результат);
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого ЗаписьУдержания Из НаборЗаписейУдержаний Цикл
		ДобавитьСуммуСотруднику(СуммыПоСотрудникам, ЗаписьУдержания.Сотрудник, -ЗаписьУдержания.Результат);
	КонецЦикла;
	
	НаборЗаписейВзаиморасчетов.Записывать = Истина;
	
	Для Каждого ЭлементСоответствия Из СуммыПоСотрудникам Цикл
		
		Если ЭлементСоответствия.Значение = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = НаборЗаписейВзаиморасчетов.ДобавитьПриход();
		Движение.Период = Период;
		Движение.Сотрудник = ЭлементСоответствия.Ключ;
		Движение.Сумма = ЭлементСоответствия.Значение;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Функция СтавкаНДФЛ()
	
	Возврат 13;
	
КонецФункции


Процедура ДобавитьСуммуСотруднику(СуммыПоСотрудникам, Сотрудник, Сумма)
	
	ТекущаяСумма = СуммыПоСотрудникам[Сотрудник];
	Если ТекущаяСумма = Неопределено Тогда
		ТекущаяСумма = 0;
	КонецЕсли;
	СуммыПоСотрудникам.Вставить(Сотрудник, ТекущаяСумма + Сумма);
	
КонецПроцедуры

#КонецОбласти
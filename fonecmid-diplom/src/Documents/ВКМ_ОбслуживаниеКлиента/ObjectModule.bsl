#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОпределитьНеобходимостьУведомления();
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Или Отказ Тогда
		Возврат;
	КонецЕсли;
	
	НачалоТекста = Неопределено;
	Если Не ДополнительныеСвойства.Свойство("ВКМ_НачалоТекстаУведомления", НачалоТекста) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстУведомления = СтрШаблон(
		НСтр("ru = '%1. Документ №%2. Клиент: %3. Специалист: %4. Дата: %5, время: %6 - %7. Проблема: %8'"),
		НачалоТекста,
		Номер,
		Клиент,
		Специалист,
		Формат(ДатаПроведенияРабот, "ДЛФ=D"),
		Формат(ВремяНачалаРаботПлан, "ДФ=HH:mm"),
		Формат(ВремяОкончанияРаботПлан, "ДФ=HH:mm"),
		ОписаниеПроблемы);
	
	Уведомление = Справочники.ВКМ_УведомленияТелеграмБоту.СоздатьЭлемент();
	Уведомление.ТекстСообщения = ТекстУведомления;
	Уведомление.Записать();
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РеквизитыДоговора = ПроверитьДоговор(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Движения.ВКМ_ВыполненныеКлиентуРаботы.Записывать = Истина;
	
	Для Каждого СтрокаРаботы Из ВыполненныеРаботы Цикл
		Если СтрокаРаботы.ЧасыКОплатеКлиенту = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.ВКМ_ВыполненныеКлиентуРаботы.Добавить();
		Движение.Период = Дата;
		Движение.Клиент = Клиент;
		Движение.Договор = Договор;
		Движение.КоличествоЧасов = СтрокаРаботы.ЧасыКОплатеКлиенту;
		Движение.СуммаКОплате = СтрокаРаботы.ЧасыКОплатеКлиенту * РеквизитыДоговора.ВКМ_СтоимостьЧасаРаботы;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, что договор абонентский и дата документа входит в период его действия.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//
// Возвращаемое значение:
//  Структура - реквизиты договора.
//
Функция ПроверитьДоговор(Отказ)
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор,
		"ВидДоговора, ВКМ_ДатаНачалаДействия, ВКМ_ДатаОкончанияДействия, ВКМ_СтоимостьЧасаРаботы");
	
	Если РеквизитыДоговора.ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Для обслуживания необходимо выбрать договор вида ""Абонентское обслуживание"".'"),
			ЭтотОбъект, "Договор", , Отказ);
		Возврат РеквизитыДоговора;
	КонецЕсли;
	
	Если Дата < НачалоДня(РеквизитыДоговора.ВКМ_ДатаНачалаДействия)
		Или (ЗначениеЗаполнено(РеквизитыДоговора.ВКМ_ДатаОкончанияДействия)
			И Дата > КонецДня(РеквизитыДоговора.ВКМ_ДатаОкончанияДействия)) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Дата документа не входит в период действия договора.'"),
			ЭтотОбъект, "Дата", , Отказ);
	КонецЕсли;
	
	Возврат РеквизитыДоговора;
	
КонецФункции

// Определяет, нужно ли отправить уведомление: документ записывается впервые
// или изменились специалист, дата либо время работ.
Процедура ОпределитьНеобходимостьУведомления()
	
	ДополнительныеСвойства.Удалить("ВКМ_НачалоТекстаУведомления");
	
	Если ЭтоНовый() Тогда
		НачалоТекста = НСтр("ru = 'Новая заявка на обслуживание'");
	Иначе
		Прежние = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка,
			"Специалист, ДатаПроведенияРабот, ВремяНачалаРаботПлан, ВремяОкончанияРаботПлан");
		Если Прежние.Специалист = Специалист
			И Прежние.ДатаПроведенияРабот = ДатаПроведенияРабот
			И Прежние.ВремяНачалаРаботПлан = ВремяНачалаРаботПлан
			И Прежние.ВремяОкончанияРаботПлан = ВремяОкончанияРаботПлан Тогда
			Возврат;
		КонецЕсли;
		НачалоТекста = НСтр("ru = 'Изменена заявка на обслуживание'");
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ВКМ_НачалоТекстаУведомления", НачалоТекста);
	
КонецПроцедуры

#КонецОбласти

#Иначе
	ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
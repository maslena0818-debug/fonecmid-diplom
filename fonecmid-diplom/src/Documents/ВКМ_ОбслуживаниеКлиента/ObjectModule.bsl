#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	РеквизитыДоговора = ПроверитьДоговор(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Движения.ВКМ_ВыполненныеКлиентуРаботы.Записывать = Истина;
	
	Для Каждого СтрокаРаботы Из ВыполненныеРаботы Цикл
		Если СтрокаРаботы.ЧасыКОплатеКлиенту = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.ВКМ_ВыполненныеКлиентуРаботы.Добавить();
		Движение.Период = Дата;
		Движение.Клиент = Клиент;
		Движение.Договор = Договор;
		Движение.КоличествоЧасов = СтрокаРаботы.ЧасыКОплатеКлиенту;
		Движение.СуммаКОплате = СтрокаРаботы.ЧасыКОплатеКлиенту * РеквизитыДоговора.ВКМ_СтоимостьЧасаРаботы;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, что договор абонентский и дата документа входит в период его действия.
//
// Параметры:
//  Отказ - Булево - признак отказа от проведения.
//
// Возвращаемое значение:
//  Структура - реквизиты договора.
//
Функция ПроверитьДоговор(Отказ)
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор,
		"ВидДоговора, ВКМ_ДатаНачалаДействия, ВКМ_ДатаОкончанияДействия, ВКМ_СтоимостьЧасаРаботы");
	
	Если РеквизитыДоговора.ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбонентскоеОбслуживание Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Для обслуживания необходимо выбрать договор вида ""Абонентское обслуживание"".'"),
			ЭтотОбъект, "Договор", , Отказ);
		Возврат РеквизитыДоговора;
	КонецЕсли;
	
	Если Дата < НачалоДня(РеквизитыДоговора.ВКМ_ДатаНачалаДействия)
		Или (ЗначениеЗаполнено(РеквизитыДоговора.ВКМ_ДатаОкончанияДействия)
			И Дата > КонецДня(РеквизитыДоговора.ВКМ_ДатаОкончанияДействия)) Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Дата документа не входит в период действия договора.'"),
			ЭтотОбъект, "Дата", , Отказ);
	КонецЕсли;
	
	Возврат РеквизитыДоговора;
	
КонецФункции

#КонецОбласти

#Иначе
	ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли